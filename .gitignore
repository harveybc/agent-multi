# Python/runtime noise
__pycache__/
*.pyc

# Credentials and machine-local authority. Public examples must contain only
# placeholders or documentation-reserved addresses.
#
# DO NOT widen this block to `*.env.conf` (finding AUD-GEN-20260816-256).
# Reviewed NON-SECRET systemd environment payloads that are shipped
# deliverables — currently
# examples/config/phase_3_eth_sac_dynamics/p1lr_env_v2/seed*.env.conf —
# deliberately carry that suffix so a newly generated one is visible to
# `git status` instead of vanishing the way the earlier seed*.env payload
# did. tests/test_wo4_identity_supervision.py fails if they become
# ignored or untracked again. Secrets still belong nowhere in git.
.env
.env.*
*.env
!*.env.example
*.pem
*.p12
*.key
credentials/
secrets/
private_runtime/

# Project 3 generated outputs; keep reproducible code/specs in git, not runs.
examples/results/*
!examples/results/phase_1_asset_policy/
examples/results/phase_1_asset_policy/*
!examples/results/phase_1_asset_policy/README.md
!examples/results/phase_1_asset_policy/*_promotion_candidates.json
experiments/weekly_walkforward_pool/configs/
experiments/weekly_walkforward_pool/runs/
experiments/weekly_walkforward_pool/*.sqlite
experiments/weekly_walkforward_pool/*.sqlite-shm
experiments/weekly_walkforward_pool/*.sqlite-wal
experiments/weekly_walkforward_pool/*.bak
experiments/weekly_walkforward_pool/*.log
experiments/weekly_walkforward_pool/*.token
experiments/weekly_walkforward_pool/*.json
experiments/weekly_walkforward_pool_materialize_smoke/
experiments/oracle_behavior_pretraining/smoke_oracle_bc_run/
experiments/oracle_behavior_pretraining/*.json
**/policy.zip
**/subprocess_stdout*.log
**/training_progress.json

# Canonical configuration is regenerated for each local execution.
/resolved_config.json
/config_manifest.json
/artifacts/

# Build/install metadata is never source of truth.
*.egg-info/
.pytest_cache/
