{
  "schema": "agent_multi.raw_baseline_design.v1",
  "scope": "EURUSD_CORE_PRICES_ONLY_NOT_FINAL_FEATURE_SELECTION",
  "scientific_scope": "REAL_DATA_DEVELOPMENT",
  "seeds": [7],
  "arms": ["SAC_FLAT", "SAC_PER_FEATURE_CONV1D", "NO_TRADE", "PASSIVE_LONG", "PASSIVE_SHORT", "RANDOM"],
  "refit_cadence": "NONE",
  "training_stopping_rule": "FIXED_100000_TRANSITIONS_NO_HYPERPARAMETER_SEARCH",
  "cost_scope": "ANALYTICAL_ASSUMPTIONS_NOT_BROKER_VERIFIED",
  "common_config": {
    "env_plugin": "gym_fx_env",
    "pipeline_plugin": "rl_pipeline",
    "data_feed_plugin": "default_data_feed",
    "broker_plugin": "default_broker",
    "strategy_plugin": "shared_execution_envelope",
    "preprocessor_plugin": "feature_window_preprocessor",
    "reward_plugin": "pnl_reward",
    "metrics_plugin": "default_metrics",
    "simulation_engine": "backtrader",
    "headers": true,
    "date_column": "DATE_TIME",
    "price_column": "CLOSE",
    "timeframe": "1h",
    "timestamp_semantics": "completed_bar_available_at",
    "execution_transition": "next_open_v2",
    "execution_max_delay_hours": 1,
    "action_space_mode": "continuous",
    "continuous_action_contract": "target_exposure_hysteresis_v2",
    "continuous_action_threshold": 0.10,
    "require_feature_aware_preprocessor": true,
    "require_full_observation_window": true,
    "window_size": 13,
    "observation_stride_bars": 2,
    "feature_scaling": "rolling_zscore",
    "feature_scaling_window": 256,
    "include_price_window": false,
    "include_agent_state": true,
    "agent_state_contract": "live_stationary_v2",
    "temporal_branch_filters": 4,
    "temporal_core_filters": 8,
    "temporal_kernel_size": 3,
    "net_arch": [32, 32],
    "initial_cash": 10000,
    "reward_scale": 1000,
    "commission": 0.00005,
    "slippage_perc": 0.00005,
    "leverage": 1,
    "min_equity": 1000,
    "financing_enabled": true,
    "financing_model": "backtrader_annual_notional_daily_v1",
    "financing_annual_rate": 0.05,
    "max_entries_per_day": 1,
    "entry_day_timezone": "America/New_York",
    "execution_envelope": {
      "envelope_mode": "atr",
      "atr_window": 14,
      "atr_sl_mult": 2,
      "atr_tp_mult": 4,
      "leverage_cap": 1,
      "entry_cost_headroom": 0.002,
      "max_entries_per_day": 1,
      "entry_day_timezone": "America/New_York"
    },
    "session_exposure_enabled": true,
    "session_venue": "historical_business_policy",
    "session_symbol": "EURUSD",
    "session_spread_column": "ASSUMED_SPREAD",
    "session_exposure_policy": {
      "enabled": true,
      "session_source": "venue_symbol_sessions_v1",
      "wind_down_hours": 24,
      "forced_flatten_hours": 12,
      "cancel_pending_on_wind_down": true,
      "allow_risk_increase_during_wind_down": false,
      "reopen_min_hours": 12,
      "reopen_min_closed_bars": 12,
      "stability_consecutive_checks": 2,
      "max_spread_relative_to_baseline": 3,
      "max_gap_sigma": 6,
      "max_realized_vol_relative_to_baseline": 4,
      "carried_position_recovery": "protected_opportunistic_then_forced",
      "holiday_policy": "same_as_weekly",
      "reopen_baseline_bars": 24,
      "reopen_gap_sigma_bars": 24,
      "reopen_realized_vol_bars": 24,
      "release_probation_factor": 2
    },
    "total_timesteps": 100000,
    "training_transition_cap": 100000,
    "evaluation_transition_cap": 30000,
    "learning_rate": 0.0003,
    "learning_starts": 1000,
    "buffer_size": 100000,
    "batch_size": 256,
    "train_freq": 1,
    "gradient_steps": 1,
    "tau": 0.005,
    "gamma": 0.99,
    "ent_coef": "auto",
    "target_entropy": "auto",
    "agent_verbose": 0,
    "quiet_mode": true
  }
}
