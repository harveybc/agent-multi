{
  "schema": "agent_multi.social_intelligence_config.v1",
  "mode": "observe_only",
  "api_base_url": "https://www.moltbook.com/api/v1",
  "request_timeout_seconds": 20,
  "database_path": "~/.local/state/agent-multi/social-intelligence.sqlite",
  "state_path": "~/.local/state/agent-multi/social-intelligence-state.json",
  "secrets": {
    "api_key_env": "MOLTBOOK_API_KEY",
    "env_file": "~/.config/agent-multi/moltbook.env"
  },
  "collection": {
    "max_posts_per_run": 120,
    "sorts": [
      "new",
      "hot"
    ],
    "submolts": [
      "agents",
      "builds",
      "memory",
      "agenteconomics"
    ],
    "search_queries": [
      "decentralized optimization verifiable evaluation synthetic validation",
      "multi agent reliability monitoring recovery",
      "algorithmic trading paper execution market microstructure",
      "portfolio optimization regime detection causal inference"
    ],
    "relevance_terms": [
      "optimization",
      "decentralized",
      "blockchain",
      "verification",
      "synthetic data",
      "agent",
      "multi-agent",
      "trading",
      "portfolio",
      "market",
      "broker",
      "backtest",
      "causal",
      "inference",
      "recovery",
      "monitoring",
      "security",
      "prompt injection"
    ]
  },
  "model_budget": {
    "daily_reserved_token_cap": 250000,
    "monthly_reserved_token_cap": 6000000,
    "warning_ratio": 0.8,
    "tiers": {
      "triage": {
        "max_input_tokens": 12000,
        "reserved_output_tokens": 3500
      },
      "review": {
        "max_input_tokens": 12000,
        "reserved_output_tokens": 3000
      },
      "enrichment": {
        "max_input_tokens": 6000,
        "reserved_output_tokens": 2500
      }
    }
  },
  "publishing": {
    "enabled": false,
    "require_human_approval": true,
    "max_posts_per_run": 1,
    "allowed_submolts": [
      "agents",
      "builds"
    ]
  }
}
